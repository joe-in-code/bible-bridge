{
  "name": "bible-bridge",
  "version": "1.0.0",
  "description": "Guided biblical-retelling environment",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --env-file-if-exists=.env --watch server.js",
    "test": "node --test \"test/*.test.js\"",
    "fetch-passages": "node scripts/fetch-passages.mjs"
  },
  "engines": {
    "node": ">=22.9"
  },
  "dependencies": {
    "express": "^4.19.2",
    "openai": "^4.67.0"
  }
}
