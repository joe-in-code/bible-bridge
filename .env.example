# Copy to .env (never commit .env)

# Option A: OpenAI directly
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Option B: OpenRouter (use this OR OPENAI_API_KEY, not both)
# OPENROUTER_API_KEY=sk-or-...
# Leave OPENAI_MODEL unset to use OpenRouter's Auto Router ("openrouter/auto"):
# it dynamically picks a model per request from live OpenRouter-wide usage,
# so no model name is hardcoded in the app. Steer it with a cost tier:
# OPENROUTER_COST_TIER=low        # low | medium | high | xhigh | max
# ...or pin an exact "provider/model" id instead of Auto Router:
# OPENAI_MODEL=anthropic/claude-sonnet-4.5
# OPENROUTER_SITE_URL=http://localhost:3000
# OPENROUTER_SITE_NAME=Bible-Bridge

# OPENAI_MAX_TOKENS=4096
# PORT=3000
# HOST=127.0.0.1
